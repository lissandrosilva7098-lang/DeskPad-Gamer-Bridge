+package com.deskpad.app
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+
+/**
+ * 1.32: controle de sessão para o app DeskPad Gamer Bridge (com.deskpad.gamerbridge).
+ *
+ * Protegido pela permissão com.deskpad.permission.CONTROL_SESSION (protectionLevel="signature"): só um app assinado com a
+ * MESMA chave do DeskPad consegue chamar. Faz só o que "Sair do DeskPad" já faz (finish da tela): não apaga dados, não altera
+ * configurações e não mexe na entrada automática pelo monitor.
+ *
+ * Responde no resultCode de um broadcast ordenado:
+ *  - QUERY_SESSION: 1 = desktop aberto, 2 = fechado.
+ *  - END_SESSION:   1 = sessão encerrada, 2 = não havia sessão.
+ */
+class SessionControlReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        val action = intent.action ?: return
+        try {
+            Diag.init(context)
+        } catch (t: Throwable) {
+        }
+        when (action) {
+            ACTION_QUERY -> {
+                val open = TouchpadActivity.desktopUp
+                answer(if (open) 1 else 2)
+            }
+            ACTION_END -> {
+                val reason = intent.getStringExtra(EXTRA_REASON) ?: "?"
+                val ended = TouchpadActivity.alive && TouchpadActivity.exitFromGamer()
+                Diag.log("gamer", "Pedido do Gamer Bridge para encerrar a sessão (motivo=" + reason + "): " + (if (ended) "encerrada" else "não havia sessão"))
+                answer(if (ended) 1 else 2)
+            }
+        }
+    }
+
+    /** Só um broadcast ordenado tem resultado; num normal, ignora. */
+    private fun answer(code: Int) {
+        if (isOrderedBroadcast) resultCode = code
+    }
+
+    companion object {
+        const val ACTION_QUERY = "com.deskpad.app.action.QUERY_SESSION"
+        const val ACTION_END = "com.deskpad.app.action.END_SESSION"
+        const val EXTRA_REASON = "com.deskpad.app.extra.REASON"
+    }
+}
